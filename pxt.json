{
    "name": "butia-microbit-extension",
    "version": "0.1.0",
    "description": "MakeCode extension for the Butia v4 educational robotics kit — imperative, event-based and reactive block paradigms.",
    "dependencies": {
        "core": "*",
        "datalogger": "*"
    },
    "files": [
        "src/blocks/blocks.ts",
        "src/core/connector.ts",
        "src/core/constants.ts",
        "src/core/event-monitor.ts",
        "src/core/logger.ts",
        "src/core/robot-base.ts",
        "src/hardware/butia-robot.ts",
        "src/hardware/button-sensor-butia.ts",
        "src/hardware/distance-sensor-butia.ts",
        "src/hardware/generic-sensor-butia.ts",
        "src/hardware/gpio-motor-driver.ts",
        "src/hardware/gray-sensor-butia.ts",
        "src/hardware/light-sensor-butia.ts",
        "src/main.ts",
        "src/robotdriver.ts",
        "src/sim/sim-map.ts",
        "src/sim/sim-motor-driver.ts",
        "src/sim/sim-robot.ts",
        "src/sim/sim-sensors.ts",
        "src/sim/sim-state.ts",
        "src/types/components.d.ts",
        "src/types/enums.d.ts",
        "src/types/robot.d.ts",
        "README.md"
    ],
    "testFiles": [
        "test/_mocks.ts",
        "test/event-monitor.test.ts",
        "test/mock.test.ts",
        "test/robot.test.ts",
        "test/sensor.test.ts",
        "test/sim-bridge.test.ts"
    ],
    "targetVersions": {
        "target": "8.0.21",
        "targetId": "microbit"
    },
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "blocksprj"
}
